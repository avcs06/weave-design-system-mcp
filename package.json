{
  "name": "@avcs/weave-design-system-mcp",
  "version": "1.0.0",
  "description": "Generic MCP server that makes any design system (tokens + components) queryable by coding agents, and agent-generated UI checkable against it.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "design-system",
    "design-tokens",
    "vanilla-extract",
    "tailwind",
    "storybook",
    "ai-agents"
  ],
  "homepage": "https://github.com/avcs06/weave-design-system-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/avcs06/weave-design-system-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/avcs06/weave-design-system-mcp/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "bin": {
    "weave-design-system-mcp": "dist/mcp/stdio.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/mcp/stdio.ts",
    "start": "node dist/mcp/stdio.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@babel/parser": "^8.0.4",
    "@babel/traverse": "^8.0.4",
    "@modelcontextprotocol/server": "^2.0.0",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "~5.9.3",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "prettier": "^3.4.2",
    "react": "^19.2.8",
    "tsx": "^4.23.13",
    "vitest": "^3.2.4"
  }
}
